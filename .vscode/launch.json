{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug CNC App",
            "type": "cppdbg",
            "request": "launch",
            // Cmake Tools extension variable to get the path to the built target
            "program": "${workspaceFolder}/build/cnc/cnc_app",
            "args": [],
            "stopAtEntry": false,
            // Set the working directory to the workspace root
            "cwd": "${workspaceFolder}/build/cnc",
            
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}