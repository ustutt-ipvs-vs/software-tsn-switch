@startuml

package "TSN Control Daemon" {

package "Netlink Components" {
class NestedAttrBuilder {
    - attrs : std::vector<attrBuilderItem*>
    - maxPayloadLength : const int
    - nlh : nlmsghdr*
    + NestedAttrBuilder(maxPayloadLength: int)
    + ~NestedAttrBuilder()

    + addAttribute(attrBuilderItemID: int, type: int, data: const void*, len: int) : int
    + addAttribute(nlh: nlmsghdr*, type: int, data: const void*, len: int) : int
    + addAttrLength(attrBuilderID: const int, length: const int) : void
    - insertAttr(attr: attrBuilderItem*, type: int, data: const void*, len: int) : int
    - clearAttrVector() : void
}

class NetconfNetlinkMapper {
    + mapToTaprio(iface: const ietfInterface_t&) : TaprioConfig
    + fromNsToPtp(Ns: uint64_t) : PtpTime_t
    + fromNsToRational(Ns: uint64_t) : RationalTime_t
    - rationalToNs(rationalTime: const RationalTime_t&) : uint64_t
    - ptpToNs(time: const PtpTime_t&) : uint64_t
}

class NetlinkSocket {
    - socketFd : const int
    - response : std::vector<nlmsghdr*>
    + NetlinkSocket()
    + ~NetlinkSocket()

    + addRtaAttribute(nlh: struct nlmsghdr*, maxlen: int, type: int, data: const void*, len: int) : rtattr*
    + sendMessage(nlh: nlmsghdr*, len: size_t) : void
    + getResponse() : std::vector<nlmsghdr*> const
    - connectSocket() : int
    - saveResponse() : void
    - clearResponse() : void
}

class QdiscManager {
    + setQdisc(netlink_socket: NetlinkSocket&, ifname: const std::string&, taprioConfig: TaprioConfig&) : void
    + removeQdisc(netlink_socket: NetlinkSocket&, ifname: const std::string&) : void
    + getQdiscInfo(netlink_socket: NetlinkSocket&, ifname: const std::string&) : void
    + getAllQdiscInfo(netlink_socket: NetlinkSocket&) : void
    + printKernelResponse(sock: const NetlinkSocket&) : void
    + getInterfacesInResponse(sock: const NetlinkSocket&, interfacesMap: std::map<int, ietfInterface_t>&, currentReqId: uint32_t) : void
    - fillTaprioOptions(rta: const rtattr*, len: int, ifToFill: ietfInterface_t&) : void
    - fillTaprioAdminSched(rta: const rtattr*, len: int, ifToFill: ietfInterface_t&) : void
    - fillTaprioSchedEntry(rta: const rtattr*, len: int, gclEntriesToFill: std::vector<GclEntry_t>&) : void
    - printTaprioOptions(rta: const rtattr*, len: int) : void
    - printTaprioSchedEntry(rta: const rtattr*, len: int) : void
    - printSingleQdisc(nlh: const nlmsghdr*) : void
    - parseAdminSchedule(rta: const rtattr*, len: int) : void
    - parseEntryList(rta: const rtattr*, len: int) : void
    - printPriomap(rta: const rtattr*) : void
    - parsePriomap(rta: const rtattr*, ifToFill: ietfInterface_t&) : void
}
}

class tsnctrld {
    - m_sock : NetlinkSocket
    - m_qm : QdiscManager
    - m_lm : LinkManager
    - m_mapper : NetconfNetlinkMapper
    - m_conn : sysrepo::Connection
    - m_sess : sysrepo::Session
    - m_operSess : sysrepo::Session
    - m_subs : std::vector<sysrepo::Subscription>
    - m_lldpDaemon : std::unique_ptr<LldpDaemon>
    - m_ifcache : InterfacesCache
    - m_pathsToReset : std::vector<std::string>
    + tsnctrld()
    + initialize() : void

    - defaultOperCallback(...) : sysrepo::ErrorCode
    - operInterfaceCallback(...) : sysrepo::ErrorCode
    - operBridgeCallback(...) : sysrepo::ErrorCode
    - operLldpCallback(...) : sysrepo::ErrorCode
    - defaultChangeCallback(...) : sysrepo::ErrorCode
    - changeInterfaceCallback(...) : sysrepo::ErrorCode
    - changeBridgeCallback(...) : sysrepo::ErrorCode
    - changeGptCallback(...) : sysrepo::ErrorCode
    - changeLldpCallback(...) : sysrepo::ErrorCode
    - syncHardwareToRunning() : void
    - setupSubscriptions() : void
    - syncInterfaceFromSysrepo(sess: sysrepo::Session&, ifname: const std::string&, requestId: uint32_t) : ietfInterface_t*
    - resetTriggerLeaf(xpath: const std::string&) : void
    - getLeaf<T>(node: const std::optional<libyang::DataNode>&, path: const std::string&) : T
}
package "Network Control" {
class LldpDaemon {
    - m_operSess : sysrepo::Session&
    - m_queryConn : lldpctl_conn_t*
    - m_watchConn : lldpctl_conn_t*
    - m_watchThread : std::thread
    - m_sessMutex : std::mutex
    - m_stop : std::atomic<bool>
    + explicit LldpDaemon(sysrepo::Session& operSession)

    + syncInitialNeighbors() : void
    + startWatching() : void
    + processEvent(type: lldpctl_change_t, iface: lldpctl_atom_t*, neigh: lldpctl_atom_t*) : void
    + LldpDaemon(const LldpDaemon&) = delete
    + operator=(const LldpDaemon&) : LldpDaemon& = delete
    - getStr(atom: lldpctl_atom_t*, key: lldpctl_key_t) : std::string
    - currentTimeMark() : uint32_t
    - refreshPortNeighbors(ifName: const std::string&) : void
}

class InterfacesCache {
    - m_interfaces : std::map<int, ietfInterface_t>
    - m_currentRequestId : uint32_t
    - m_fullLinkDumpDone : bool
    - m_fullQdiscDumpDone : bool
    + setCurrentRequestId(reqId: uint32_t) : void
    + getInterface(ifindex: int) : ietfInterface_t*
    + getInterface(name: const std::string&) : ietfInterface_t*
    + getAllInterfaces() : std::map<int, ietfInterface_t>&
    + ensureFullLinkData(sock: NetlinkSocket&) : void
    + ensureFullQdiscData(sock: NetlinkSocket&) : void
}

class LinkManager {
    + getAllInterfaces(netlinkSocket: NetlinkSocket&) : void
    + getInterface(netlinkSocket: NetlinkSocket&, ifindex: int) : void
    + printLinkResponse(sock: const NetlinkSocket&) : void
    + getInterfacesInResponse(sock: const NetlinkSocket&, interfacesMap: std::map<int, ietfInterface_t>&, currentReqId: uint32_t) : void
}
}


tsnctrld *-- NetlinkSocket
tsnctrld *-- InterfacesCache
tsnctrld *-- LldpDaemon
tsnctrld --> QdiscManager
tsnctrld --> LinkManager
tsnctrld --> NetconfNetlinkMapper
QdiscManager --> NetconfNetlinkMapper
QdiscManager --> NestedAttrBuilder
QdiscManager --> NetlinkSocket
LinkManager --> NetlinkSocket

@enduml